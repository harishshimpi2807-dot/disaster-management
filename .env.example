# API
APP_NAME=Sentinel Recovery
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
API_CORS_ORIGINS=http://localhost:3000

# Database — use PostGIS in Docker, or SQLite for local demo
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL=sqlite:///./data/sentinel.db

# Object storage — local disk by default; set S3_* to use MinIO/S3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=sentinel-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# AI inference — leave empty to use the modular mock providers
CHANGE_DETECTION_URL=
DAMAGE_CLASSIFIER_URL=
ANOMALY_MODEL_URL=
SIMILARITY_MODEL_URL=

NEXT_PUBLIC_API_URL=http://localhost:8000
